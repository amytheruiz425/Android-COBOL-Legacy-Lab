>>SOURCE FORMAT FREE

IDENTIFICATION DIVISION.
PROGRAM-ID. MISSION-TELEMETRY.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TELEMETRY-FILE
        ASSIGN TO "mission_telemetry.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD TELEMETRY-FILE.
01 TELEMETRY-RECORD PIC X(60).

WORKING-STORAGE SECTION.
01 MISSION-ID        PIC X(9) VALUE "MISSION01".
01 ALTITUDE-KM       PIC X(6) VALUE "185.00".
01 VELOCITY-KMS      PIC X(4) VALUE "7.75".
01 FUEL-PERCENT      PIC X(5) VALUE "62.00".
01 TEMPERATURE-C     PIC X(5) VALUE "48.00".

PROCEDURE DIVISION.
    OPEN OUTPUT TELEMETRY-FILE

    MOVE SPACES TO TELEMETRY-RECORD

    STRING
        MISSION-ID DELIMITED BY SIZE
        " " DELIMITED BY SIZE
        ALTITUDE-KM DELIMITED BY SIZE
        " " DELIMITED BY SIZE
        VELOCITY-KMS DELIMITED BY SIZE
        " " DELIMITED BY SIZE
        FUEL-PERCENT DELIMITED BY SIZE
        " " DELIMITED BY SIZE
        TEMPERATURE-C DELIMITED BY SIZE
        INTO TELEMETRY-RECORD
    END-STRING

    WRITE TELEMETRY-RECORD
    CLOSE TELEMETRY-FILE

    DISPLAY "COBOL MISSION TELEMETRY CREATED"
    DISPLAY "MISSION: MISSION01"
    DISPLAY "ALTITUDE: 185.00 KM"
    DISPLAY "VELOCITY: 7.75 KM/S"
    DISPLAY "FUEL: 62.00%"
    DISPLAY "TEMPERATURE: 48.00 C"

    STOP RUN.
