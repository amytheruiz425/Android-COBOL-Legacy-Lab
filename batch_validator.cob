IDENTIFICATION DIVISION.
PROGRAM-ID. BATCH-VALIDATOR.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TRANSACTION-FILE
        ASSIGN TO "transactions.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD TRANSACTION-FILE.
01 TRANSACTION-RECORD.
    05 ACCOUNT-ID          PIC X(6).
    05 TRANSACTION-AMOUNT  PIC 9(5)V99.

WORKING-STORAGE SECTION.
01 END-FLAG PIC X VALUE "N".
    88 END-OF-FILE VALUE "Y".

01 ACCEPTED-COUNT PIC 9(2) VALUE ZERO.
01 REJECTED-COUNT PIC 9(2) VALUE ZERO.
01 ACCEPTED-TOTAL PIC 9(7)V99 VALUE ZERO.
01 DISPLAY-TOTAL  PIC Z,ZZZ,ZZ9.99.

PROCEDURE DIVISION.
    OPEN INPUT TRANSACTION-FILE

    PERFORM UNTIL END-OF-FILE
        READ TRANSACTION-FILE
            AT END
                SET END-OF-FILE TO TRUE
            NOT AT END
                PERFORM VALIDATE-TRANSACTION
        END-READ
    END-PERFORM

    CLOSE TRANSACTION-FILE

    MOVE ACCEPTED-TOTAL TO DISPLAY-TOTAL

    DISPLAY "BATCH VALIDATION REPORT"
    DISPLAY "ACCEPTED: " ACCEPTED-COUNT
    DISPLAY "REJECTED: " REJECTED-COUNT
    DISPLAY "TOTAL:    " DISPLAY-TOTAL

    STOP RUN.

VALIDATE-TRANSACTION.
    IF ACCOUNT-ID = SPACES
       OR TRANSACTION-AMOUNT = ZERO
        ADD 1 TO REJECTED-COUNT
    ELSE
        ADD 1 TO ACCEPTED-COUNT
        ADD TRANSACTION-AMOUNT TO ACCEPTED-TOTAL
    END-IF.
