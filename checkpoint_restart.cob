IDENTIFICATION DIVISION.
PROGRAM-ID. CHECKPOINT-RESTART.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT JOB-FILE
        ASSIGN TO "jobs.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

    SELECT OPTIONAL CHECKPOINT-FILE
        ASSIGN TO "checkpoint.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.

FD JOB-FILE.
01 JOB-RECORD.
    05 JOB-SEQUENCE PIC 9(2).
    05 JOB-SYSTEM   PIC X(6).
    05 JOB-HEALTH   PIC 9(3).

FD CHECKPOINT-FILE.
01 CHECKPOINT-RECORD PIC 9(2).

WORKING-STORAGE SECTION.
01 LAST-SEQUENCE PIC 9(2) VALUE ZERO.

01 END-FLAG PIC X VALUE "N".
    88 END-OF-FILE VALUE "Y".

01 FOUND-FLAG PIC X VALUE "N".
    88 RECORD-FOUND VALUE "Y".

PROCEDURE DIVISION.
    OPEN INPUT CHECKPOINT-FILE

    READ CHECKPOINT-FILE
        AT END
            MOVE ZERO TO LAST-SEQUENCE
        NOT AT END
            MOVE CHECKPOINT-RECORD TO LAST-SEQUENCE
    END-READ

    CLOSE CHECKPOINT-FILE

    DISPLAY "LAST CHECKPOINT: " LAST-SEQUENCE

    OPEN INPUT JOB-FILE

    PERFORM UNTIL END-OF-FILE OR RECORD-FOUND
        READ JOB-FILE
            AT END
                SET END-OF-FILE TO TRUE
            NOT AT END
                IF JOB-SEQUENCE > LAST-SEQUENCE
                    DISPLAY "PROCESSING: " JOB-SEQUENCE
                            " " JOB-SYSTEM
                            " HEALTH=" JOB-HEALTH
                    MOVE JOB-SEQUENCE TO LAST-SEQUENCE
                    SET RECORD-FOUND TO TRUE
                END-IF
        END-READ
    END-PERFORM

    CLOSE JOB-FILE

    IF RECORD-FOUND
        OPEN OUTPUT CHECKPOINT-FILE
        MOVE LAST-SEQUENCE TO CHECKPOINT-RECORD
        WRITE CHECKPOINT-RECORD
        CLOSE CHECKPOINT-FILE
        DISPLAY "CHECKPOINT SAVED: " LAST-SEQUENCE
    ELSE
        DISPLAY "NO UNPROCESSED RECORDS"
    END-IF

    STOP RUN.
