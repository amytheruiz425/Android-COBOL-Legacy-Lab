IDENTIFICATION DIVISION.
PROGRAM-ID. FIXED-RECORD-READER.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT SYSTEM-FILE
        ASSIGN TO "system_records.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD SYSTEM-FILE.
01 SYSTEM-RECORD.
    05 SYSTEM-ID       PIC X(6).
    05 HEALTH-SCORE    PIC 9(3).
    05 INCIDENT-COUNT  PIC 9(2).
    05 ALERT-CODE      PIC X.

PROCEDURE DIVISION.
    OPEN INPUT SYSTEM-FILE

    READ SYSTEM-FILE
        AT END
            DISPLAY "NO SYSTEM RECORD FOUND"
        NOT AT END
            DISPLAY "SYSTEM:    " SYSTEM-ID
            DISPLAY "HEALTH:    " HEALTH-SCORE
            DISPLAY "INCIDENTS: " INCIDENT-COUNT
            DISPLAY "ALERT:     " ALERT-CODE

            IF HEALTH-SCORE < 050 OR ALERT-CODE = "A"
                DISPLAY "STATUS:    UNDER STRESS"
            ELSE
                DISPLAY "STATUS:    STABLE"
            END-IF
    END-READ

    CLOSE SYSTEM-FILE
    STOP RUN.
