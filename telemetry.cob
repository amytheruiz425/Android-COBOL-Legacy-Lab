IDENTIFICATION DIVISION.
PROGRAM-ID. TELEMETRY.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TELEMETRY-FILE
        ASSIGN TO "telemetry.txt"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD TELEMETRY-FILE.
01 TELEMETRY-RECORD PIC X(20).

WORKING-STORAGE SECTION.
01 HEALTH-SCORE   PIC 9(3) VALUE 045.
01 INCIDENT-COUNT PIC 9(2) VALUE 03.
01 ALERT-CODE     PIC X    VALUE "A".

PROCEDURE DIVISION.
    OPEN OUTPUT TELEMETRY-FILE

    MOVE SPACES TO TELEMETRY-RECORD
    STRING "HEALTH="
           HEALTH-SCORE
           DELIMITED BY SIZE
           INTO TELEMETRY-RECORD
    END-STRING
    WRITE TELEMETRY-RECORD

    MOVE SPACES TO TELEMETRY-RECORD
    STRING "INCIDENTS="
           INCIDENT-COUNT
           DELIMITED BY SIZE
           INTO TELEMETRY-RECORD
    END-STRING
    WRITE TELEMETRY-RECORD

    MOVE SPACES TO TELEMETRY-RECORD
    STRING "ALERT="
           ALERT-CODE
           DELIMITED BY SIZE
           INTO TELEMETRY-RECORD
    END-STRING
    WRITE TELEMETRY-RECORD

    CLOSE TELEMETRY-FILE
    DISPLAY "TELEMETRY FILE CREATED"
    STOP RUN.
